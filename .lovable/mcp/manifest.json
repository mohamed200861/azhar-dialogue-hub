{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://jqyioadvwldtiszmpmlt.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "azhar-global-connect",
      "version": "0.1.0",
      "title": "Azhar Global Connect"
    },
    "tools": [
      {
        "name": "search_content",
        "title": "Search published content",
        "description": "Search the union's published content (news, library items, videos, khutbahs, Quran lessons, events) by title.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Text to match against titles."
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "news",
                  "library",
                  "videos",
                  "khutbahs",
                  "quran",
                  "events"
                ]
              },
              "description": "Limit the search to these content types. Defaults to all."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "description": "Max results per source (default 5)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_news_article",
        "title": "Get news article",
        "description": "Fetch a single published news article with its full body, by slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "The article slug, e.g. 'annual-conference-2026'."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_upcoming_events",
        "title": "List upcoming events",
        "description": "List published events starting from now, ordered by start date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max events to return (default 10)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_news_draft",
        "title": "Create news draft",
        "description": "Create a draft news article (never published directly). Requires an editor/admin account; RLS enforces permissions.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 3,
              "description": "Article headline."
            },
            "slug": {
              "type": "string",
              "minLength": 3,
              "pattern": "^[a-z0-9\\u0600-\\u06FF-]+$",
              "description": "URL slug, lowercase with hyphens."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "Content category, e.g. 'news'."
            },
            "excerpt": {
              "type": "string",
              "description": "Short summary."
            },
            "content": {
              "type": "string",
              "description": "Full HTML/rich-text body."
            }
          },
          "required": [
            "title",
            "slug",
            "category"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
